<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="clipboard"
        path="clipboard/" />
    <!-- Camera captures for the Image tool (P07-T04): the camera app writes here, the note stores a copy. -->
    <cache-path
        name="camera"
        path="camera/" />
    <!-- Attachments written for another app to open (A-070): cache/attachments/<asset id prefix>/<name>. -->
    <cache-path
        name="attachments"
        path="attachments/" />
</paths>
